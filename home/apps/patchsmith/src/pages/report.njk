---
title: "Spec Report"
layout: "layouts/base.njk"
---

<h2>Spec Report</h2>

<div id="report-content">
  Loading report...
</div>

<script>
  async function loadReport() {
    try {
      const response = await fetch('/spec-report.json');
      const report = await response.json();
      
      const html = `
        <div class="report">
          <div class="summary">
            <h3>Summary</h3>
            <p>Total Specs: ${report.specs}</p>
            <p>Total Entities: ${report.entities}</p>
            <p>Total Routes: ${report.routes}</p>
            <p>Errors: ${report.errors.length}</p>
            <p>Warnings: ${report.warnings.length}</p>
          </div>
          
          ${report.errors.length > 0 ? `
          <div class="errors">
            <h3>Errors</h3>
            <ul>
              ${report.errors.map(e => `<li>${e}</li>`).join('')}
            </ul>
          </div>
          ` : ''}
          
          ${report.warnings.length > 0 ? `
          <div class="warnings">
            <h3>Warnings</h3>
            <ul>
              ${report.warnings.map(w => `<li>${w}</li>`).join('')}
            </ul>
          </div>
          ` : ''}
        </div>
      `;
      
      document.getElementById('report-content').innerHTML = html;
    } catch (error) {
      document.getElementById('report-content').innerHTML = 
        `<div class="error">Failed to load report: ${error.message}</div>`;
    }
  }
  
  loadReport();
</script>

<style>
  .report { margin: 2rem 0; }
  .summary { background: #f5f5f5; padding: 1rem; border-radius: 4px; margin-bottom: 2rem; }
  .errors { color: #d32f2f; background: #ffebee; padding: 1rem; border-radius: 4px; }
  .warnings { color: #ffa000; background: #fff3e0; padding: 1rem; border-radius: 4px; }
  ul { list-style: disc; padding-left: 2rem; }
</style>